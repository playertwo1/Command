{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "assets": [
          { "path": "dist/velopack/Command-Setup.exe", "label": "Command para Windows (instalador)" },
          { "path": "dist/Command-win-x64.zip", "label": "Command para Windows (.zip, sem instalar)" },
          { "path": "dist/velopack/*.nupkg", "label": "Command update packages" },
          { "path": "dist/velopack/releases.win.json", "label": "Command update feed" },
          { "path": "dist/velopack/assets.win.json", "label": "Command update assets" },
          { "path": "dist/velopack/RELEASES", "label": "Command release manifest" },
          { "path": "dist/Command.apk", "label": "App Android (.apk)" }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ]
  ]
}
